---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="about" class="border-b border-border pt-12 pb-9">
      <p class="text-sm font-semibold tracking-widest text-accent uppercase">
        About
      </p>
      <h1
        class="mt-3 max-w-2xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
      >
        Blogs and projects on engineering, AI systems, and building
      </h1>
      <p class="mt-5 max-w-[68ch] text-lg leading-8 text-subtle">
        I write about the practical work behind reliable software and applied
        AI. Outside work, I spend as much time as I can surfing, sailing, and
        spearfishing.
      </p>
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="posts" class="pt-11 pb-6">
          <h2 class="text-2xl font-semibold tracking-tight">Latest writing</h2>
          <ul class="mt-5">
            {sortedPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
