---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">

    <section id="about" class="pt-12 pb-6 border-b border-border">
      <h2 class="text-2xl font-semibold tracking-wide">About</h2>
      <p class="mt-4">
        I'm a lover of all things ocean (surfing, sailing, spearfishing), philosophical ideas, and building things. Space for sharing writing on personal projects. Enjoy.
      </p>
    </section>

    {sortedPosts.length > 0 && (
      <section id="posts" class="pt-12 pb-6">
        <h2 class="text-3xl font-bold tracking-wide">Posts</h2>
        <ul class="mt-6">
          {sortedPosts.map((data) => <Card variant="h3" {...data} />)}
        </ul>
      </section>
    )}

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
