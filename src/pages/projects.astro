---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const projects = [
  {
    name: "Persona Simulator",
    href: "/posts/persona-simulator/",
    description:
      "A grounded simulation system for testing how realistic user personas respond to product experiences and AI agents before launch.",
  },
  {
    name: "AI SRE Agent",
    href: "/posts/running-an-ai-sre-on-the-claude-platform/",
    description:
      "An incident-response agent that gathers production evidence, develops root-cause hypotheses, and routes proposed actions through human approval.",
  },
];
---

<Layout title="Projects | Ivaylo Bahtchevanov">
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-b border-border pt-12 pb-9">
      <p class="text-sm font-semibold tracking-widest text-accent uppercase">
        Portfolio
      </p>
      <h1
        class="mt-3 max-w-2xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
      >
        Projects
      </h1>
      <p class="mt-5 max-w-[68ch] text-lg leading-8 text-subtle">
        Applied AI systems and engineering tools I’ve designed and built.
      </p>
    </section>

    <section aria-labelledby="selected-projects" class="pt-11 pb-6">
      <h2 id="selected-projects" class="text-2xl font-semibold tracking-tight">
        Selected projects
      </h2>
      <ul class="mt-5 divide-y divide-border border-y border-border">
        {
          projects.map(project => (
            <li>
              <a
                href={project.href}
                class="group block py-7 sm:py-8"
                aria-label={`Read about ${project.name}`}
              >
                <h3 class="text-2xl font-semibold tracking-tight group-hover:text-accent">
                  {project.name}
                </h3>
                <p class="mt-3 max-w-[74ch] text-lg leading-8 text-subtle">
                  {project.description}
                </p>
                <span class="mt-4 inline-block font-medium text-accent">
                  View project <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
