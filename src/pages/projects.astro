---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const projects = [
  {
    name: "Persona Simulator",
    description:
      "A grounded simulation system for testing how realistic user personas respond to product experiences and AI agents before launch.",
    links: [
      {
        label: "Read article",
        href: "/posts/persona-simulator/",
        external: false,
      },
    ],
  },
  {
    name: "AI SRE Agent",
    description:
      "An incident-response agent that gathers production evidence, develops root-cause hypotheses, and routes proposed actions through human approval.",
    links: [
      {
        label: "Read article",
        href: "/posts/running-an-ai-sre-on-the-claude-platform/",
        external: false,
      },
    ],
  },
  {
    name: "CostSegNow",
    description:
      "A self-service cost segregation tool that turns rental-property details into accelerated-depreciation estimates and downloadable reports.",
    links: [
      {
        label: "Live site",
        href: "https://costsegnow.vercel.app/",
        external: true,
      },
      {
        label: "GitHub",
        href: "https://github.com/ivaylogb/costseg-pro",
        external: true,
      },
    ],
  },
  {
    name: "Pluma",
    description:
      "A CLI that routes developer-product failures across funnel, agent-evaluation, and integration-trace diagnostics, then combines the evidence into one report.",
    links: [
      {
        label: "GitHub",
        href: "https://github.com/ivaylogb/pluma",
        external: true,
      },
    ],
  },
];
---

<Layout title="Projects | Ivaylo Bahtchevanov">
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-b border-border pt-12 pb-9">
      <p class="text-sm font-semibold tracking-widest text-accent uppercase">
        Portfolio
      </p>
      <h1
        class="mt-3 max-w-2xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
      >
        Projects
      </h1>
      <p class="mt-5 max-w-[68ch] text-lg leading-8 text-subtle">
        Applied AI systems and engineering tools I’ve designed and built.
      </p>
    </section>

    <section aria-labelledby="selected-projects" class="pt-11 pb-6">
      <h2 id="selected-projects" class="text-2xl font-semibold tracking-tight">
        Selected projects
      </h2>
      <ul class="mt-5 divide-y divide-border border-y border-border">
        {
          projects.map(project => (
            <li class="py-7 sm:py-8">
              <h3 class="text-2xl font-semibold tracking-tight">
                {project.name}
              </h3>
              <p class="mt-3 max-w-[74ch] text-lg leading-8 text-subtle">
                {project.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
                {project.links.map(link => (
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="font-medium text-accent hover:underline"
                  >
                    {link.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
